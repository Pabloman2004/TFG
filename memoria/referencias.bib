% =====================================================================
%  Bibliografia - estilo IEEE (admitido por la guia de la ESEI)
%  La guia exige: autor, titulo, editorial/revista, numero-volumen-
%  paginas (revistas), anho, y URL + fecha de consulta para web.
%  Y sobre todo: ESTILO UNIFORME en toda la seccion.
% =====================================================================

@article{ejemplo-articulo,
  author  = {Apellido, Nombre and Apellido, Nombre},
  title   = {Título del artículo},
  journal = {Nombre de la revista},
  volume  = {00},
  number  = {0},
  pages   = {1--10},
  year    = {2023},
  doi     = {10.0000/ejemplo}
}

@book{ejemplo-libro,
  author    = {Apellido, Nombre},
  title     = {Título del libro},
  publisher = {Editorial},
  year      = {2022},
  edition   = {2}
}

@online{ejemplo-web,
  author  = {Organización},
  title   = {Título del recurso},
  url     = {https://ejemplo.org},
  urldate = {2026-08-09},
  year    = {2026}
}
